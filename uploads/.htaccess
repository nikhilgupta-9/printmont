<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /printmont/printmont-backend/uploads/

    # Do not rewrite if requesting watermarks directory or cache directory
    RewriteCond %{REQUEST_URI} !^/printmont/printmont-backend/uploads/(watermarks|cache)/ [NC]

    # Only route through watermark handler when download / watermark flag is requested
    RewriteCond %{QUERY_STRING} (download=1|wm=1|export=1|save=1|dl=1) [NC]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} \.(jpe?g|png|bmp|gif)$ [NC]
    RewriteRule ^(.*)$ /printmont/printmont-backend/watermark-handler.php?src=uploads/$1&download=1 [QSA,L]
</IfModule>

# Copy this file to config/.env on the server and fill in the real values.
# config/.env is gitignored — it must be uploaded manually, never committed.
#
# Find these in Hostinger hPanel -> Databases -> Management:
#   DB_NAME / DB_USER look like u950539402_something

APP_ENV=production
APP_BASE_URL=https://mediumvioletred-pelican-783174.hostingersite.com/

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Local XAMPP values, for reference — leaving config/.env absent gives you these:
#   APP_ENV=local
#   APP_BASE_URL=http://localhost/printmont/
#   DB_NAME=printmont_db
#   DB_USER=root
#   DB_PASS=
